{
  "mcpServers": {
    "polymarket": {
      "command": "/home/user/polymarket-mcp-server/venv/bin/polymarket-mcp",
      "env": {
        "DOTENV_PATH": "/home/user/polymarket-mcp-server/.env"
      }
    },
    "gpt-researcher": {
      "command": "/home/user/gptr-mcp/venv/bin/python",
      "args": ["/home/user/gptr-mcp/server.py"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "firecrawl": {
      "command": "/opt/node22/bin/npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "your_firecrawl_api_key_here"
      }
    }
  }
}
