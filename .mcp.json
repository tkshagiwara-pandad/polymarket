{
  "mcpServers": {
    "polymarket": {
      "command": "/home/user/polymarket-mcp-server/venv/bin/polymarket-mcp",
      "env": {
        "DOTENV_PATH": "/home/user/polymarket-mcp-server/.env"
      }
    },
    "gpt-researcher": {
      "command": "/home/user/gptr-mcp/venv/bin/python",
      "args": ["/home/user/gptr-mcp/server.py"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
  }
}
