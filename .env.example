# ============================================================
# Polymarket / Kalshi アービトラージボット 設定
# cp .env.example .env して値を記入してください
# ============================================================

# ─── 動作モード ───────────────────────────────────────────
# true = ペーパートレード（デフォルト・推奨）
# false = ライブトレード（要全認証情報）
PAPER_TRADING=true

# ─── Polymarket ──────────────────────────────────────────
POLYGON_PRIVATE_KEY=your_polygon_private_key_here
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ─── Kalshi ──────────────────────────────────────────────
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private.pem

# ─── Telegram通知 ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── ログレベル ──────────────────────────────────────────
LOG_LEVEL=INFO
