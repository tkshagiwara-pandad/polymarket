# ============================================================
# Polymarket / Kalshi アービトラージボット 設定
# cp .env.example .env して値を記入してください
# ============================================================

# ─── 動作モード ───────────────────────────────────────────
# true = ペーパートレード（デフォルト・推奨）
# false = ライブトレード（要全認証情報）
PAPER_TRADING=true

# ─── Polymarket ──────────────────────────────────────────
POLYGON_PRIVATE_KEY=your_polygon_private_key_here
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ─── Kalshi ──────────────────────────────────────────────
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private.pem

# ─── 通知設定（Apprise）────────────────────────────────────
# カンマ区切りで複数サービスを同時指定可能
# Telegram:  tgram://BOT_TOKEN/CHAT_ID
# Slack:     slack://TOKEN/CHANNEL
# Discord:   discord://WEBHOOK_ID/WEBHOOK_TOKEN
# Email:     mailto://user:pass@gmail.com
# LINE:      line://token/
# 詳細: https://github.com/caronc/apprise/wiki
APPRISE_URLS=

# ─── ログレベル ──────────────────────────────────────────
LOG_LEVEL=INFO
